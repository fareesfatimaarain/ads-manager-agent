{
  "name": "ads-manager-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run && vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "seed": "tsx src/seed/demo.ts",
    "admin:create": "tsx src/scripts/createAdmin.ts",
    "web:build": "vite build",
    "web:dev": "vite",
    "serve": "tsx src/api/server.ts",
    "scheduler": "tsx src/scheduler/index.ts",
    "start": "npm run web:build && npm run serve"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "bullmq": "^5.34.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "express": "^4.21.2",
    "framer-motion": "^13.0.0",
    "ioredis": "^5.4.2",
    "multer": "^2.2.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "drizzle-kit": "^0.30.1",
    "puppeteer-core": "^25.5.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
