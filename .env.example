NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://ads:ads_local_dev_only@localhost:5433/ads_manager
REDIS_URL=redis://localhost:6380

# 32-byte key, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEVER commit a real value. In production this comes from a KMS/secret manager,
# not from a file on disk.
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1

ANTHROPIC_API_KEY=
IDEOGRAM_API_KEY=

# Meta Marketing API — sandbox credentials only until step 3 is signed off.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0

# Master switch. When false, no adapter may perform a mutating platform call,
# regardless of per-client settings. Defaults to false; must be explicitly enabled.
EXECUTION_ENABLED=false
